{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec 'npx tsx --env-file=.env src/server.ts'",
    "build": "tsc",
    "start": "node --env-file=.env dist/src/server.js",
    "lint": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "load:setup": "tsx load/harness/setup.ts",
    "load:socket": "k6 run --out json=load/results/socket-connect.json load/k6/socket-connect.js",
    "load:messages": "k6 run --out json=load/results/message-throughput.json load/k6/message-throughput.js",
    "load:rest": "k6 run --out json=load/results/rest-baseline.json load/k6/rest-baseline.js",
    "load:teardown": "tsx load/harness/teardown.ts",
    "seed": "tsx scripts/seed-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
